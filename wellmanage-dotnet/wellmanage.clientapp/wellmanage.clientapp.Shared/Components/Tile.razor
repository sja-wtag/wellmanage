@using MudBlazor

<MudCard Style="width: 100%; height: 150px;" Class="pa-4">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="9">
                <MudText Typo="Typo.h6" Color="Color.Primary">@Title</MudText>
                <MudText Typo="Typo.h4" Class="mt-2">@Value</MudText>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Subtitle</MudText>
                }
            </MudItem>
            <MudItem xs="3" Class="d-flex justify-end align-start">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Primary" />
                }
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Title { get; set; }
    [Parameter] public string Value { get; set; }
    [Parameter] public string Subtitle { get; set; }
    [Parameter] public string Icon { get; set; }
}
