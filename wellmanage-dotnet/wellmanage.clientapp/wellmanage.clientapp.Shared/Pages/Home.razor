@page "/home"
@using Microsoft.AspNetCore.Authorization
@using wellmanage.clientapp.Shared.Services
@inject IFormFactor FormFactor

<PageTitle>Home</PageTitle>

<h1>Welcome to Well Manage HRM!</h1>



<MudGrid GutterSize="3">
    <MudItem xs="12" sm="6" md="3">
        <Tile Title="Tasks" Value="1" Subtitle="Pending" Icon="@Icons.Material.Filled.Task" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <Tile Title="Projects" Value="1" Subtitle="Assigned" Icon="@Icons.Material.Filled.Work" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <Tile Title="Late Count" Value="3" Subtitle="This Month" Icon="@Icons.Material.Filled.Block" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <Tile Title="Members" Value="4" Subtitle="Active" Icon="@Icons.Material.Filled.People" />
    </MudItem>
</MudGrid>
